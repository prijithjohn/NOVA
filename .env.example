# Spring Boot backend HTTP port
SERVER_PORT=3001

# PostgreSQL connection used by Spring Boot
DB_URL=jdbc:postgresql://localhost:5435/nova
DB_USERNAME=nova
DB_PASSWORD=change-me-local-only

# PostgreSQL container values for local development
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=change-me-local-only

# Frontend API base path; Vite proxies /api to the backend during development
VITE_API_BASE_URL=/api
